{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
        "preset": {
            "name": "angular"
        },
        "infile": "CHANGELOG.md"
    },
    "@csmith/release-it-calver-plugin": {
        "format": "yyyy.mm.minor",
        "increment": "calendar"
    }
  }
}